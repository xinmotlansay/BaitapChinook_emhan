          <layout class="QVBoxLayout" name="layoutChart">
           <item><widget class="QWidget" name="chartHost"/></item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- Tab 2: so sánh mô hình -->
      <widget class="QWidget" name="tabCompare">
       <attribute name="title"><string>So sánh mô hình</string></attribute>
       <layout class="QVBoxLayout" name="layoutTab2" stretch="0,1">
        <item>
         <layout class="QHBoxLayout" name="layoutCompareControls">
          <item><widget class="QLabel" name="lblLevel"><property name="text"><string>Đối tượng:</string></property></widget></item>
