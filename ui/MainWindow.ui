           <layout class="QVBoxLayout" name="layoutCompareChart">
            <item><widget class="QWidget" name="chartHostCompare"/></item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- Tab 3: thông tin dữ liệu và mô hình -->
      <widget class="QWidget" name="tabInfo">
       <attribute name="title"><string>Thông tin dữ liệu &amp;&amp; mô hình</string></attribute>
       <layout class="QHBoxLayout" name="layoutTab3">
        <item>
         <widget class="QGroupBox" name="grpDataInfo">
          <property name="title"><string>Thống kê dữ liệu</string></property>
          <layout class="QVBoxLayout" name="layoutDataInfo">
           <item><widget class="QPlainTextEdit" name="txtDataInfo"><property name="readOnly"><bool>true</bool></property></widget></item>
